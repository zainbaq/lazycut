GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-3.8-flash     # free-tier Flash model; listed as stable in the Gemini docs on 2026-11-14
ANTHROPIC_API_KEY=                      # research, clip finding and writing; Gemini only watches video
ANTHROPIC_MODEL=                        # Claude model id for those calls; empty = claude-opus-5-5
YOUTUBE_API_KEY=                        # optional; research degrades gracefully without it
HIGGSFIELD_API_KEY=                     # thumbnails: the API key from console.higgsfield.ai, as shown ("id:secret"); each image is a paid call
IMPORT_DIR=./inbox                      # host folder to import videos from (read-only)
DATA_DIR=/data
DB_PATH=/db/app.db
CONFIG_DIR=/config
WEB_ORIGIN=http://localhost:3000        # the only origin allowed by CORS
ANALYSIS_FPS=1                          # full-pass sampling rate; the only rate measured in Phase 0
ANALYSIS_MEDIA_RESOLUTION=              # low | medium | high; empty = the model's default, the only setting measured in Phase 0
EVENT_DETECTORS=gemini                  # comma-separated event detectors, in merge priority order
EVENT_SNAP=off                          # off | visual
SEARCH_DEMAND=youtube_suggest           # youtube_suggest | off: free YouTube search suggestions for titles and tags
EXPORT_VERTICAL_SIZE=1080x1920
WATCH_POLLING=false
